generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStage {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum Timeline {
  asap
  one_to_three_months
  three_to_six_months
  six_plus_months
  flexible
}

enum UserRole {
  super_admin
  crm
  cms
  both
}

enum ContactWeekPart {
  working_days
  weekends
}

enum ContactDayPart {
  morning
  late_night
}

model Lead {
  id                  String            @id @default(cuid())
  companyName         String
  personFullName      String
  personRole          String
  subject             String
  need                String
  budgetMinAmount     Int
  budgetCurrency      String            @default("usd")
  timeline            Timeline
  serviceSlug         String?
  wantsConsultation   Boolean           @default(false)
  contactWeekPart     ContactWeekPart?
  contactDayPart      ContactDayPart?
  stage               LeadStage         @default(new)
  openedAt            DateTime?
  assignedUserId      String?
  assignedUser        User?             @relation(fields: [assignedUserId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  links               LeadLink[]
  phones              LeadPhone[]
  notes               LeadNote[]
  reminders           LeadReminder[]
}

model LeadLink {
  id        String @id @default(cuid())
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int    @default(0)
}

model LeadPhone {
  id        String @id @default(cuid())
  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  number    String
  sortOrder Int    @default(0)
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model LeadReminder {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  leads        Lead[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Mailbox {
  id             String @id @default(cuid())
  responsibility String @unique
  address        String
}
